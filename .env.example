APP_NAME="Fibro Laminates"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
# Set only when public_html is separate from the private Laravel directory:
# APP_PUBLIC_PATH=/absolute/path/to/public_html
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fibro
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Set temporarily when creating the first admin account, then remove the password.
ADMIN_SEED_NAME="Fibro Admin"
# Set this only when renaming an existing admin login.
ADMIN_SEED_CURRENT_EMAIL=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
