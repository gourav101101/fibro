APP_NAME="Fibro Laminates"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://test.mdarena.in
# Set only when public_html is separate from the private Laravel directory:
# APP_PUBLIC_PATH=/absolute/path/to/public_html
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
# User-confirmed Hostinger database settings (2026-10-02).
DB_DATABASE=u308075782_fibro
DB_USERNAME=u308075782_fibro
# Set privately on the host; never commit the database password.
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Use "log" without a mail provider. Enquiries are still saved in the admin inbox,
# and notification emails are written to storage/logs/laravel.log.
# For real delivery, change this to "smtp" and complete the settings below.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENQUIRY_TO_ADDRESS=fibrolaminates@gmail.com
MAIL_ENQUIRY_TO_NAME="Fibro Laminates"

# Set temporarily when creating the first admin account, then remove the password.
ADMIN_SEED_NAME="Fibro Admin"
# Set this only when renaming an existing admin login.
ADMIN_SEED_CURRENT_EMAIL=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
