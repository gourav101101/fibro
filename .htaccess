Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # The project root is used by XAMPP; application files stay private.
    RewriteRule (^|/)\. - [F,END]
    RewriteRule ^(?:app|bootstrap|config|database|docs|node_modules|resources|routes|scripts|storage|tests|vendor)(?:/|$) - [F,END,NC]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect only browser requests, never an internal asset rewrite.
    # Preserve form methods and bodies when submitted from an old /public page.
    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)?/public(?:/([^?\s]*))?(?:[?\s]) [NC]
    RewriteRule ^public(?:/.*)?$ %1/%2 [R=307,L]

    RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)?/public(?:/([^?\s]*))?(?:[?\s]) [NC]
    RewriteRule ^public(?:/.*)?$ %1/%2 [R=301,L]

    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)?/index\.php(?:/([^?\s]*))?(?:[?\s]) [NC]
    RewriteRule ^index\.php(?:/.*)?$ %1/%2 [R=307,L]

    RewriteCond %{THE_REQUEST} \s(/[^?\s]*?)?/index\.php(?:/([^?\s]*))?(?:[?\s]) [NC]
    RewriteRule ^index\.php(?:/.*)?$ %1/%2 [R=301,L]

    # Only the public asset directories are served directly.
    RewriteRule ^(?:build|images|video|css)/.*\.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,END,NC]
    RewriteRule ^((?:build|images|video|css)/.*)$ public/$1 [END]

    # Keep SCRIPT_NAME at the project root so Laravel generates clean URLs.
    RewriteRule ^index\.php$ - [END]
    RewriteRule ^ index.php [END]
</IfModule>
